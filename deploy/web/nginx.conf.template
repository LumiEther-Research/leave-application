server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml font/ttf font/otf;
  gzip_min_length 1024;

  include /etc/nginx/security-headers.conf;

  # The API. The browser sees one origin; the Bearer token travels in the Authorization header.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 60s;
    client_max_body_size 1m;
  }

  # Vite writes content-hashed files under /assets, so they can be cached for a year and a missing one must be a real
  # 404 (never index.html served as if it were a script). index.html names those files, so it must never be stale,
  # or a new release would load a mix of old and new.
  location /assets/ {
    include /etc/nginx/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }
  location = /index.html { include /etc/nginx/security-headers.conf; add_header Cache-Control "no-cache"; }

  # Single-page app: any other path is a client-side route, so serve index.html (deep links and reloads work).
  location / {
    try_files $uri $uri/ /index.html;
  }
}
