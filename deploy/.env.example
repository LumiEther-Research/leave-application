# Copy to deploy/.env and fill in. Never commit .env.
# Postgres connection URL: the *pooled* Neon connection string, or the URL of any other Postgres database.
DATABASE_URL=

# Signs the session cookie (lr_session). 32+ random characters generated just for this: openssl rand -base64 48
# It must NOT be the same value as SESSION_SECRET below. Without it nobody can sign in.
LR_COOKIE_SECRET=

# Where state-changing requests (POST, PUT, PATCH, DELETE) may come from: the public address of the web container,
# comma separated, no path. Anything else is refused (CSRF defence). Production example: https://leave.example.com
# PRODUCTION: only the public https address. Never add a development origin such as the Vite dev server's
# http://localhost:5173 (or http://127.0.0.1:5173). A developer sets that in their own shell when running the backend
# by hand; it does not belong in this file. The value below is the local docker-compose address, for local runs only.
ALLOWED_ORIGINS=http://localhost:8088

# Adds the Secure attribute to the session cookie, so it is only sent over https. Leave it true behind Traefik's TLS;
# set false only for plain-http local runs. (Chrome and Firefox also accept Secure cookies on http://localhost.)
COOKIE_SECURE=true

# RETIRED for the rebuild. The current Node app signs its session cookie with this; the Helidon backend does not read it
# and the compose file does not pass it on. It stays here only so one env file can still serve the current app.
# Do not reuse this value for LR_COOKIE_SECRET.
SESSION_SECRET=

# Bootstrap only: while the database has no admins, this account can sign in once and is then saved as a normal admin.
# Hash: printf '%s' 'the password' | node scripts/hash-password.mjs
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Used by the monthly payslip job, which arrives in a later phase. 16+ random characters.
CRON_SECRET=

# Which image tag to run, and the port the web container is published on.
IMAGE_TAG=latest
WEB_PORT=8088
