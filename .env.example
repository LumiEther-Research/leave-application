# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres. Use the *pooled* connection string from the Neon console (Connection details).
# On Vercel, add the Neon integration or set this in Project Settings > Environment Variables.
# Create the tables once with: npm run db:migrate
DATABASE_URL=

# A separate Neon *branch* used only by `npm test`. The tests empty its tables, so it must never be
# the same database as DATABASE_URL. Create the tables with: npm run db:migrate:test
DATABASE_URL_TEST=

# Bootstrap only. While the database has no admins, this account can sign in once; it is then saved as
# an ordinary admin and these two values are ignored. Admins are managed in the app after that.
ADMIN_EMAIL=admin@example.com
# Generate with: printf '%s' 'your password' | npm run --silent hash-password
ADMIN_PASSWORD_HASH=

# Signs the session cookie. Any random string of 32+ characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
